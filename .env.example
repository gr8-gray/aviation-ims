# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aviation_ims
DB_USER=ims_app
DB_PASSWORD=changeme

# Server
PORT=3000
HTTPS_PORT=3443
SESSION_SECRET=changeme

# Dev auth bypass — when true, EDIPI comes from the X-Dev-EDIPI header instead of a CAC cert.
# REQUIRED for local/dev demos (vite :5173 + screenshots.mjs). Leave unset/false in prod (real CAC).
DEV_AUTH=true

# TLS (paths to cert files — never commit the actual certs)
TLS_KEY_PATH=./certs/server.key
TLS_CERT_PATH=./certs/server.crt
TLS_CA_PATH=./certs/ca.crt

# FLIS / DLA (populated after Track 2 research)
DLA_API_KEY=
DLA_API_BASE_URL=

# OTS (populated after Track 1 research)
OTS_BASE_URL=
